{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "asg-airlines"
		},
		"AzureBlob_Airlines_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlob_Airlines'"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureBlob_Airlines')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Connection to ASG Airlines Azure Blob Storage",
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('AzureBlob_Airlines_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Clean_Flights_CSV')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlob_Airlines",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"container": "clean"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlob_Airlines')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PII_protection')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlob_Airlines",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Excel",
				"typeProperties": {
					"sheetName": "passengers",
					"location": {
						"type": "AzureBlobStorageLocation",
						"container": "raw"
					},
					"firstRowAsHeader": true
				},
				"schema": [
					{
						"name": "passenger_id",
						"type": "String"
					},
					{
						"name": "first_name",
						"type": "String"
					},
					{
						"name": "last_name",
						"type": "String"
					},
					{
						"name": "age",
						"type": "String"
					},
					{
						"name": "gender",
						"type": "String"
					},
					{
						"name": "email",
						"type": "String"
					},
					{
						"name": "phone",
						"type": "String"
					},
					{
						"name": "aadhaar_id",
						"type": "String"
					},
					{
						"name": "date_of_birth",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlob_Airlines')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Protected_Passengers_CSV')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlob_Airlines",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "protected_passengers.csv",
						"folderPath": "passengers",
						"container": "clean"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlob_Airlines')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Raw_Flights')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlob_Airlines",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Excel",
				"typeProperties": {
					"sheetName": "flights",
					"location": {
						"type": "AzureBlobStorageLocation",
						"container": "raw"
					},
					"firstRowAsHeader": true
				},
				"schema": [
					{
						"name": "flight_id",
						"type": "String"
					},
					{
						"name": "airline",
						"type": "String"
					},
					{
						"name": "source",
						"type": "String"
					},
					{
						"name": "destination",
						"type": "String"
					},
					{
						"name": "departure_time",
						"type": "String"
					},
					{
						"name": "arrival_time",
						"type": "String"
					},
					{
						"name": "duration",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlob_Airlines')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Clean_Flights')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Raw_Flights",
								"type": "DatasetReference"
							},
							"name": "RawFlights"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Clean_Flights_CSV",
								"type": "DatasetReference"
							},
							"name": "CleanFlightsSink"
						}
					],
					"transformations": [
						{
							"name": "SelectFlights"
						},
						{
							"name": "DeriveFlightFields"
						},
						{
							"name": "ValidFlights"
						},
						{
							"name": "DeduplicateFlights"
						}
					],
					"scriptLines": [
						"source(output(",
						"          flight_id as string,",
						"          airline as string,",
						"          source as string,",
						"          destination as string,",
						"          departure_time as string,",
						"          arrival_time as string,",
						"          duration as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> RawFlights",
						"RawFlights select(mapColumn(",
						"          flight_id,",
						"          airline,",
						"          source,",
						"          destination,",
						"          departure_time,",
						"          arrival_time,",
						"          duration",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectFlights",
						"SelectFlights derive(flight_id = upper(trim(flight_id)),",
						"          airline = trim(airline),",
						"          source = upper(trim(source)),",
						"          destination = upper(trim(destination)),",
						"          departure_ts = toTimestamp(departure_time, \"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\"),",
						"          arrival_ts = toTimestamp(arrival_time, \"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\"),",
						"          duration_minutes = (toLong(toTimestamp(arrival_time, \"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\")) - toLong(toTimestamp(departure_time, \"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\"))) / 60000) ~> DeriveFlightFields",
						"DeriveFlightFields filter(!isNull(flight_id)) ~> ValidFlights",
						"ValidFlights aggregate(groupBy(flight_id,",
						"          airline,",
						"          source,",
						"          destination,",
						"          departure_ts,",
						"          arrival_ts),",
						"     duration_minutes = first(duration_minutes)) ~> DeduplicateFlights",
						"DeduplicateFlights sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['clean_flights.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> CleanFlightsSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Raw_Flights')]",
				"[concat(variables('factoryId'), '/datasets/Clean_Flights_CSV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Protect_Passenger_PII')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "PII_protection",
								"type": "DatasetReference"
							},
							"name": "RawPassengers"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Protected_Passengers_CSV",
								"type": "DatasetReference"
							},
							"name": "ProtectedPassengers"
						}
					],
					"transformations": [
						{
							"name": "MaskPII"
						},
						{
							"name": "SelectProtectedFields"
						}
					],
					"scriptLines": [
						"source(output(",
						"          passenger_id as string,",
						"          first_name as string,",
						"          last_name as string,",
						"          age as string,",
						"          gender as string,",
						"          email as string,",
						"          phone as string,",
						"          aadhaar_id as string,",
						"          date_of_birth as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> RawPassengers",
						"RawPassengers derive(first_name = 'REDACTED',",
						"          last_name = 'REDACTED',",
						"          email = 'REDACTED',",
						"          phone = 'XXXXXXXXXX',",
						"          aadhaar_id = 'XXXXXXXXXXXX',",
						"          date_of_birth = 'REDACTED') ~> MaskPII",
						"MaskPII select(mapColumn(",
						"          passenger_id,",
						"          first_name,",
						"          last_name,",
						"          age,",
						"          gender,",
						"          email,",
						"          phone,",
						"          aadhaar_id,",
						"          date_of_birth",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectProtectedFields",
						"SelectProtectedFields sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> ProtectedPassengers"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/PII_protection')]",
				"[concat(variables('factoryId'), '/datasets/Protected_Passengers_CSV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Clean_Flights')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Run_Clean_Flights",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "Clean_Flights",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"RawFlights": {},
									"CleanFlightsSink": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Coarse"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-09-10T07:53:41Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/Clean_Flights')]"
			]
		}
	]
}